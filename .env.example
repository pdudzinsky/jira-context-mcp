# Jira Cloud connection (required)
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=your-atlassian-api-token

# HTTP client tuning (optional)
# REQUEST_TIMEOUT=30.0
# MAX_RETRIES=3

# Optional: cap on attachment download size for get_ticket_attachment.
# Files larger than this are refused with an Error pointing to content_url.
# Default: 20 (must be > 0).
# JIRA_ATTACHMENT_MAX_MB=20
